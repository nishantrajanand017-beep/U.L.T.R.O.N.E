GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Local Kokoro TTS Server Configuration (Port 8880)
KOKORO_API_URL=http://127.0.0.1:8880/v1/audio/speech
KOKORO_VOICE=am_adam
KOKORO_SPEED=1.0

# Local Whisper STT Server Configuration (Port 8881)
WHISPER_API_URL=http://127.0.0.1:8881/v1/audio/transcriptions
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=en

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Security & Encryption (AES-256-GCM master key secret)
ENCRYPTION_SECRET=your_32_byte_or_random_encryption_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
ULTRON_DEVICE_WS_PORT=3001

# Local Qwen LLM Server Configuration (Port 11434, Ollama OpenAI-compatible endpoint)
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen3:8b

