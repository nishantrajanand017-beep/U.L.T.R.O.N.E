# ==============================================================================
# ULTRON ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Dashboard for production deployments.
# ==============================================================================

# ==============================================================================
# 1. REMOTE PRODUCTION INFERENCE GATEWAY (SERVER-SIDE ONLY)
# ==============================================================================
# When running in production (ENVIRONMENT=production or NODE_ENV=production):
# - AI_INFERENCE_API_KEY is MANDATORY (fails closed if missing).
# - AI_INFERENCE_URL MUST use HTTPS (https://).
# - Localhost and private LAN IP addresses are strictly prohibited in production.
#
# Unified Gateway URL (Preferred):
AI_INFERENCE_URL=https://YOUR-INFERENCE-DOMAIN.example
AI_INFERENCE_API_KEY=your_production_ai_inference_api_key_here

# Optional Provider-Specific Overrides (Leave commented out to use AI_INFERENCE_URL):
# QWEN_INFERENCE_URL=https://YOUR-INFERENCE-DOMAIN.example/v1
# WHISPER_INFERENCE_URL=https://YOUR-INFERENCE-DOMAIN.example/v1/audio/transcriptions
# KOKORO_INFERENCE_URL=https://YOUR-INFERENCE-DOMAIN.example/v1/audio/speech

# Environment Indicator
# ENVIRONMENT=production

# ==============================================================================
# 2. LOCAL DEVELOPMENT INFERENCE SERVICES (OPTIONAL LOCAL OVERRIDES)
# ==============================================================================
# In local development (NODE_ENV !== "production"):
# If AI_INFERENCE_URL is not provided, ULTRON automatically defaults to:
#   Qwen (Ollama):    http://127.0.0.1:11434/v1
#   Whisper STT:      http://127.0.0.1:8881/v1/audio/transcriptions
#   Kokoro TTS:       http://127.0.0.1:8880/v1/audio/speech
# No API key is required when running locally against 127.0.0.1.

# Local Kokoro-82M TTS Server Configuration (Port 8880)
KOKORO_API_URL=http://127.0.0.1:8880/v1/audio/speech
KOKORO_VOICE=am_adam
KOKORO_SPEED=1.0

# Local Whisper STT Server Configuration (Port 8881)
WHISPER_API_URL=http://127.0.0.1:8881/v1/audio/transcriptions
WHISPER_MODEL=small
WHISPER_LANGUAGE=en

# Local Qwen LLM Server Configuration (Port 11434, Ollama / OpenAI-compatible endpoint)
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=Qwen/Qwen3-4B

# ==============================================================================
# 3. FALLBACK CLOUD AI PROVIDERS (SERVER-SIDE ONLY)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ==============================================================================
# 4. SUPABASE AUTH & DATABASE CONFIGURATION (CLIENT & SERVER)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================================================================
# 5. SECURITY, ENCRYPTION & DEVICE WEBSOCKET
# ==============================================================================
# AES-256-GCM master key secret (32-byte hex/base64 string or random secret)
ENCRYPTION_SECRET=your_32_byte_or_random_encryption_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
ULTRON_DEVICE_WS_PORT=3001
